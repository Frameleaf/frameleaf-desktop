  "windows": ["main"],
  "permissions": ["core:default", "allow-connect-server", "allow-restore-connection", "allow-sign-out", "allow-open-photos", "allow-worker-setup-status", "allow-prepare-models", "allow-control-worker", "allow-discover-onedrive", "allow-choose-photo-folder", "allow-approve-photo-folder", "allow-photo-source-status", "allow-revoke-photo-source", "allow-photo-import-status", "allow-prepare-photo-import", "allow-control-photo-import"]
}
