{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frameleaf",
  "version": "0.1.0",
  "identifier": "app.frameleaf.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Frameleaf",
        "width": 1040,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "shortDescription": "Your photos, with help from your computer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGQzkwODhDOUU3NDQ0QTQKUldTa1JIU2VqQWpKYjN6WVYrWTdNSzFta1VZanAxcDFOTG91YmZuSmIvK2s0czJzajNiWG9QdWoK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/Frameleaf/frameleaf-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
